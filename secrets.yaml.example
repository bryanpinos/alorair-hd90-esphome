# Copy to secrets.yaml (same folder as the .yaml builds) and fill in.
# secrets.yaml is git-ignored by convention -- never commit real credentials.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP (captive portal) password -- min 8 chars.
ap_password: "changeme-ap"

# OTA update password.
ota_password: "changeme-ota"

# Mosquitto broker credentials (Phase 2 only).
mqtt_username: "hd90"
mqtt_password: "changeme-mqtt"

# MQTT broker address. Prefer a DNS name over a bare IP so the broker
# can be repointed without reflashing.
mqtt_broker: "mqtt.example.lan"
